{
  "manifest_version": 3,
  "name": "Profile Lens",
  "short_name": "Profile Lens",
  "version": "1.4.0",
  "description": "LinkedIn and X impressions for posts, comments and replies, plus best times to post, weekly goals and pending replies. Stays local.",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "unlimitedStorage", "alarms", "notifications"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Profile Lens",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*", "https://www.linkedin.com/*"],
      "js": ["src/injected/net-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": [
        "src/lib/common.js",
        "src/lib/x-parser.js",
        "src/content/overlay.js",
        "src/content/scanner.js",
        "src/content/x-content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": [
        "src/lib/common.js",
        "src/lib/li-parser.js",
        "src/content/overlay.js",
        "src/content/scanner.js",
        "src/content/linkedin-content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
